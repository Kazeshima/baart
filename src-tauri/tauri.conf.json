{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BAART",
  "version": "1.1.3",
  "identifier": "com.kazeshima.baart",
  "build": {
    "beforeDevCommand": "npm run desktop:dev",
    "beforeBuildCommand": "npm run desktop:build",
    "devUrl": "http://127.0.0.1:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BAART — Blue Archive Arena Rating Tool",
        "width": 1400,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "visible": true,
        "additionalBrowserArgs": "--disable-features=HardwareMediaKeyHandling,OverlayScrollbar --disable-gpu-compositing"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/baart-node"
    ],
    "resources": {
      "generated/renderer/app/": "renderer/app/",
      "generated/renderer/composition/": "renderer/composition/",
      "generated/renderer/licenses/": "renderer/licenses/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
